{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "f7r-marshalboards",
  "version": "0.4.5",
  "identifier": "com.salutproductions.f7r-marshalboards",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "f7r-marshalboards",
        "width": 250,
        "height": 150,
        "minHeight": 70,
        "minWidth": 170,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/salutproductions/f7r-marshalboards/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNTg5RDUyRjAyNjdBNQpSV1NsWndJdjFZa1ZDUzg2NkQ2VWw0bnlKRU04QnF3dTNnUmYwS0F1aHJzanUrWTFLMmVOQnU4aQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}